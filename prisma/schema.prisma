datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id                   String               @id @default(cuid())
  githubId             Int                  @unique
  githubUsername       String               @unique
  name                 String?
  email                String?
  avatarUrl            String?
  organisation         String?
  role                 String?
  preferredTrack       String?
  secondTrack          String?
  skillPrompts         Int                  @default(3)
  skillTools           Int                  @default(3)
  skillRegulatory      Int                  @default(3)
  skillOutputs         Int                  @default(3)
  companyLogoUrl       String?
  showLogoOnWebsite    Boolean              @default(false)
  registrationIssue    Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  observabilityChecks  ObservabilityCheck[]
  feedback             Feedback[]
  repoClaims           RepoClaimMember[]
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String?
  text      String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SignupRequest {
  id             String    @id @default(cuid())
  githubUsername String
  email          String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
}

model ObservabilityCheck {
  id                  String   @id @default(cuid())
  planSlug            String
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  purpose             String
  usersStakeholders   String
  workflow            String
  criticalDecisions   String
  failureModes        String
  observabilityFields String
  controls            String
  auditEvidence       String
  alertsTriggers      String
  successMetrics      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([planSlug, userId])
}

// Open-source readiness: a team (≥1 dev + ≥1 auditor) claims an agent repo and
// runs the harden-agent-repo skill on it. One claim per repo; others join it.
model RepoClaim {
  id        String            @id @default(cuid())
  repo      String            @unique
  prUrl     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   RepoClaimMember[]
}

model RepoClaimMember {
  id        String    @id @default(cuid())
  claimId   String
  claim     RepoClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      String // "dev" | "auditor"
  createdAt DateTime  @default(now())

  @@unique([claimId, userId])
}
